{
	"name": "@sapphire-sh/utils",
	"version": "2.1.0",
	"description": "@sapphire-sh/utils",
	"type": "module",
	"sideEffects": false,
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"bin": {
		"sapphire-bootstrap": "./bin/sapphire-bootstrap.js"
	},
	"exports": {
		".": {
			"import": "./lib/index.js",
			"require": "./lib/cjs/index.js",
			"types": "./lib/index.d.ts"
		},
		"./eslint": {
			"import": "./lib/eslint.js",
			"require": "./lib/cjs/eslint.js",
			"types": "./lib/eslint.d.ts"
		},
		"./eslint/next": {
			"import": "./lib/eslintNext.js",
			"require": "./lib/cjs/eslintNext.js",
			"types": "./lib/eslintNext.d.ts"
		},
		"./prettier": {
			"import": "./lib/prettier.js",
			"require": "./lib/cjs/prettier.js",
			"types": "./lib/prettier.d.ts"
		},
		"./vitest": {
			"import": "./lib/vitest.js",
			"require": "./lib/cjs/vitest.js",
			"types": "./lib/vitest.d.ts"
		},
		"./vitest/next": {
			"import": "./lib/vitestNext.js",
			"require": "./lib/cjs/vitestNext.js",
			"types": "./lib/vitestNext.d.ts"
		},
		"./browser": {
			"import": "./lib/browser.js",
			"require": "./lib/cjs/browser.js",
			"types": "./lib/browser.d.ts"
		},
		"./node": {
			"import": "./lib/node.js",
			"require": "./lib/cjs/node.js",
			"types": "./lib/node.d.ts"
		},
		"./tsconfig": "./tsconfig.json",
		"./tsconfig.json": "./tsconfig.json",
		"./tsconfig.cjs": "./tsconfig.cjs.json",
		"./tsconfig.cjs.json": "./tsconfig.cjs.json"
	},
	"files": [
		"bin/**/*",
		"lib/**/*",
		"templates",
		"tsconfig.json",
		"tsconfig.cjs.json"
	],
	"scripts": {
		"bootstrap": "node bin/sapphire-bootstrap.js",
		"prebuild": "rm -fr ./lib",
		"build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && printf '{\"type\":\"commonjs\"}' > lib/cjs/package.json",
		"prepare": "npm run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphire-sh/sapphire-utils.git"
	},
	"author": "sapphire",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sapphire-sh/sapphire-utils/issues"
	},
	"homepage": "https://github.com/sapphire-sh/sapphire-utils#readme",
	"peerDependencies": {
		"@eslint/js": ">=9.0.0",
		"eslint": ">=9.0.0",
		"eslint-config-next": ">=16.0.0",
		"eslint-config-prettier": ">=9.0.0",
		"eslint-plugin-promise": ">=7.0.0",
		"next": ">=16.0.0",
		"prettier": ">=3.0.0",
		"prettier-plugin-organize-imports": ">=4.0.0",
		"typescript-eslint": ">=8.0.0",
		"vitest": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"@eslint/js": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"eslint-config-next": {
			"optional": true
		},
		"eslint-config-prettier": {
			"optional": true
		},
		"eslint-plugin-promise": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"typescript-eslint": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^9.24.0",
		"@types/node": "^25.5.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^9.24.0",
		"eslint-config-next": "^16.3.5",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-promise": "^7.2.1",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.29.1",
		"vitest": "^5.0.1"
	}
}
